FROM rocker/r-ver:4.4.3@sha256:3dae5d2eeddf74f10e0a81fb6b7ae350295e288000304f438b844b2c1e00fe2c

RUN Rscript -e 'install.packages("https://cran.r-project.org/src/contrib/RobustRankAggreg_1.2.1.tar.gz", repos=NULL, type="source"); stopifnot(as.character(packageVersion("RobustRankAggreg")) == "1.2.1")'

WORKDIR /app
